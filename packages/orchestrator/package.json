{
  "name": "@mycelium/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic control plane: plan validation, approval gate, DAG dispatcher, event sink.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
