{
  "name": "@mycelium/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts for Mycelium: plan schema, event envelope, and validators.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schemas/plan.schema.json": "./schemas/plan.schema.json",
    "./schemas/event.schema.json": "./schemas/event.schema.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.3"
  }
}
